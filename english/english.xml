<?xml version="1.1" encoding="UTF-8"?>
<!--
  The English the repair applies before it cuts anything.

  This is the same shape as autoallow/rules.xml, and for the same reason: a rule
  a reader can edit without reading Go is a rule that gets edited. Adding a word
  here is a one-line change with a test beside it, not a recompile of a table
  buried in a source file.

  Every entry is matched whole, lowercased, and only between word boundaries, so
  `just` never touches `adjustment`. A <drop> whose word changes meaning in some
  context does not belong here at all: a wrong deletion is worse than a comment
  left long, because nobody reviews what a repair applied.

  Each entry carries a `test` attribute: the phrase as it would appear in a
  comment. english_test.go runs every one of them through shorten() and requires
  the entry to actually fire, so an entry that has stopped matching says so
  rather than sitting here looking enforced.
-->
<english xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="english.xsd">

  <!--
    The word classes a shape reads when the words alone leave a sentence open
    to two readings. Every class with a word list is CLOSED: the language
    admits no new article and no new preposition, so the list is the whole
    class. A class is data, so widening one is an edit here and needs no Go.
  -->
  <class name="article" words="a an the"/>
  <class name="determiner" words="this that these those each every any no some
    another other which whichever either neither both several many few all
    its their our my your his her whose"/>
  <class name="relative" words="that which who whom whose when where while"/>
  <class name="conjunction" words="and or but so because though although if
    unless since while whereas"/>
  <class name="preposition" words="of in on at to for with from by into onto
    under over per as than through against between among about after before
    during without within across below above behind beside beyond near upon
    until toward towards along around via despite versus off out up down"/>
  <class name="auxiliary" words="is are was were be been being am has have had
    does do did can could will would shall may might must should"/>
  <class name="adverb" words="still already only never always also too here
    there now then again once twice rather quite very just even soon later
    instead however therefore not"/>
  <class name="pronoun" words="it they them we us you he him she
    something anything nothing everything"/>
  <class name="verbform" suffix="ing ed"/>
  <class name="noun" open="true" except="verbform"/>

  <!-- A central determiner opens a noun phrase, and a postdeterminer can
       follow it. "that" is left out: it is a conjunction as often. -->
  <class name="central" words="the this these those each every either neither"/>
  <!-- A postdeterminer that says nothing before a singular noun. The article
       and the singular already say "exactly this one". -->
  <class name="pleonastic" words="one single individual particular"/>
  <!-- A determiner that "one" props up when no noun follows: "this one". -->
  <class name="propped" words="this each either neither which whichever another"/>
  <class name="plural" suffix="s"/>
  <!-- A word ending like a plural after a singular determiner is the verb. -->
  <class name="singular" open="true" except="verbform plural"/>
  <!-- Nouns the "ing" ending would read as a verb form. -->
  <class name="ingnoun" words="thing string ring spring wing king ceiling"/>

  <!-- Words that survive their own deletion. -->
  <drop word="actually" test="It actually fails"/>
  <drop word="basically" test="It basically fails"/>
  <drop word="essentially" test="It essentially fails"/>
  <drop word="fundamentally" test="It fundamentally fails"/>
  <drop word="simply" test="It simply fails"/>
  <drop word="obviously" test="It obviously fails"/>
  <drop word="clearly" test="It clearly fails"/>
  <drop word="of course" test="It of course fails"/>
  <drop word="in fact" test="It in fact fails"/>
  <drop word="indeed" test="It indeed fails"/>
  <drop word="really" test="It really fails"/>
  <drop word="very" test="A very long name"/>
  <drop word="quite" test="A quite long name"/>
  <drop word="somewhat" test="A somewhat long name"/>
  <drop word="fairly" test="A fairly long name"/>
  <drop word="just" test="It just fails"/>
  <drop word="note that" test="Note that it fails"/>
  <drop word="it is worth noting that" test="It is worth noting that it fails"/>
  <drop word="please note that" test="Please note that it fails"/>
  <drop word="needless to say" test="Needless to say it fails"/>
  <drop word="at the end of the day" test="At the end of the day it fails"/>
  <drop word="for the purposes of" test="For the purposes of the check"/>
  <drop word="with respect to" test="With respect to the check"/>

  <!-- Phrases with a shorter spelling that means the same thing. -->
  <rewrite from="in order to" to="to" test="Runs in order to bind"/>
  <rewrite from="due to the fact that" to="because" test="Fails due to the fact that it races"/>
  <rewrite from="in the event that" to="if" test="Retries in the event that it fails"/>
  <rewrite from="for the purpose of" to="for" test="Kept for the purpose of the gate"/>
  <rewrite from="a large number of" to="many" test="Holds a large number of entries"/>
  <rewrite from="at this point in time" to="now" test="Correct at this point in time"/>
  <rewrite from="is able to" to="can" test="It is able to retry"/>
  <rewrite from="has the ability to" to="can" test="It has the ability to retry"/>
  <rewrite from="make use of" to="use" test="It will make use of the cache"/>
  <rewrite from="take into account" to="consider" test="It must take into account the offset"/>
  <rewrite from="the reason is because" to="because" test="The reason is because it races"/>
  <rewrite from="in spite of the fact that" to="although" test="Kept in spite of the fact that it races"/>
  <rewrite from="a sufficient number of" to="enough" test="Holds a sufficient number of entries"/>
  <rewrite from="prior to" to="before" test="Runs prior to the gate"/>
  <rewrite from="subsequent to" to="after" test="Runs subsequent to the gate"/>
  <rewrite from="in the near future" to="soon" test="Lands in the near future"/>
  <rewrite from="on a regular basis" to="regularly" test="Runs on a regular basis"/>
  <rewrite from="whether or not" to="whether" test="Asks whether or not it fits"/>

  <!-- A pleonastic postdeterminer: the determiner and the singular noun already
       say "exactly this one", so the word between them says it again. A
       hyphen binds the word into a compound, which a shape never reads across. -->
  <shape id="pleonastic-postdeterminer" match="{central:d} {pleonastic} {singular|ingnoun:n}" replace="{d} {n}"
         test="The walk is dropping the one top directory" expect="The walk is dropping the top directory">
    <test in="The one thing that matters most" out="The thing that matters most"/>
    <test in="It reads each individual file" out="It reads each file"/>
    <test in="This particular case fails" out="This case fails"/>
    <test in="It retries every single time" out="It retries every time"/>
    <test in="It arms the one-shot timer" out="It arms the one-shot timer"/>
    <test in="It keeps the one below" out="It keeps the one below"/>
    <test in="The one wins" out="The one wins"/>
    <test in="It checks that one key exists" out="It checks that one key exists"/>
    <test in="No one reads it" out="No one reads it"/>
  </shape>
  <!-- A prop-word: "one" holds the place of a noun the determiner can stand
       for alone. -->
  <shape id="prop-word-one" match="{propped:d} one" replace="{d}"
         test="It fails when this one does not carry it" expect="It fails when this does not carry it">
    <test in="It reads each one of them" out="It reads each of them"/>
    <test in="It cannot fix either one" out="It cannot fix either"/>
    <test in="It knows that one exists" out="It knows that one exists"/>
  </shape>

  <!--
    where= picks the surface an entry applies to: "comment" for source only,
    "message" for a rendered assistant message only, "both" when it reads the
    same in either. It defaults to both, so an entry that says nothing about
    surface applies everywhere.

    The split earns its keep on entries that are only wrong in one place. An
    em dash joining two clauses is a chat habit; in a comment it is already
    caught as a comma splice by the prose rules, and rewriting it here would
    fight them.
  -->
  <rewrite from="— and" to="," where="message" test="Yes — and there is precedent"/>
  <rewrite from="— but" to=", but" where="message" test="It works — but only once"/>
  <rewrite from="— so" to=", so" where="message" test="It failed — so I retried"/>
  <rewrite from="— which" to=", which" where="message" test="It races — which is the bug"/>
  <rewrite from="that being said" to="but" where="message" test="That being said it races"/>
  <drop word="it is important to note that" where="message" test="It is important to note that it races"/>

  <!--
    A <pattern> is a rewrite with captures, for a shape no whole-word swap can
    express. `replace` spells its groups $1, $2, the way Go's regexp expansion
    does, and `expect` is what `test` must become.

    A bare #N is deliberately absent. It needs the repository the reader is in,
    which is context the table does not carry, and guessing the wrong repository
    is worse than leaving plain text.

    NOTE ON linkrefs: these carry the link SHAPE, not linkrefs' guarantee.
    That plugin resolves a reference before it links, and leaves plain text
    when it cannot show the target exists. A pattern cannot check existence, so
    folding linkrefs in here would trade a verified link for a plausible one.
    Keep both: this is for a reference already known good.
  -->
  <pattern match="\b([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)\b"
           replace="[$1#$2](https://github.com/$1/issues/$2)"
           where="message"
           test="wow-look-at-my/slopfix#14 is open"
           expect="[wow-look-at-my/slopfix#14](https://github.com/wow-look-at-my/slopfix/issues/14) is open"/>

  <!--
    A tombstone: a comment describing a state the code has left, or arguing for
    the diff. Each one is cut as a PHRASE rather than as a line. Cutting the
    line takes the sentence's other half with it, and the write then lands
    broken and needs a second pass to repair.

    git log carries the history these narrate, dated and attributed, so nothing
    is lost by cutting them out of the source.
  -->
  <pattern id="tombstones/date"
           match="(?i)\s*\b(?:on|as of|since)\s+(?:19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}\b" replace=""
           where="comment" test="Verified on 2026-01-02 by hand"
           expect="Verified by hand"/>
  <pattern id="tombstones/date"
           match="(?i)\s*\(?\b(?:19|20)[0-9]{2}-[0-9]{2}-[0-9]{2}\)?" replace=""
           where="comment" test="The cap 2026-01-02 still holds"
           expect="The cap still holds"/>
  <pattern id="tombstones/change-reference"
           match="(?i)\s*\(?\b(?:see\s+)?(?:pr|pull request|issue|ticket|commit)\s+#?[0-9]+\)?" replace=""
           where="comment" test="The gate tightened see PR 14 and stayed"
           expect="The gate tightened and stayed"/>
  <pattern id="tombstones/then-and-now-contrast"
           match="(?i)\s*\binstead of (?:the )?(?:old|former|previous|legacy)\s+\S+" replace=""
           where="comment" test="It reads the index instead of the old table"
           expect="It reads the index"/>
  <pattern match="(?i)\s*\brather than (?:the )?(?:old|former|previous|legacy)\s+\S+" replace=""
           where="comment" test="It reads the index rather than the legacy table"
           expect="It reads the index"/>
  <pattern match="(?i)\s*\bwhere (?:it|this|that) (?:used to|once)\b[^.]*" replace=""
           where="comment" test="The lock is here where it used to sit below"
           expect="The lock is here"/>
  <pattern match="(?i)\s*\b(?:moved|switched|migrated|converted|renamed|changed|ported) from\b[^.]*" replace=""
           where="comment" test="The table is XML moved from a Go literal"
           expect="The table is XML"/>
  <pattern match="(?i)\s*\b(?:this|it|that) (?:used to|previously|formerly|originally)\b[^.]*" replace=""
           where="comment" test="The parse is the only reader it used to scan bytes"
           expect="The parse is the only reader"/>
  <pattern match="(?i)\s*\b(?:previously|formerly|originally|hitherto)\b[,]?" replace=""
           where="comment" test="Originally, the cap was read from a flag"
           expect="The cap was read from a flag"/>
  <pattern match="(?i)\s*\b(?:no longer|anymore|nowadays|these days)\b" replace=""
           where="comment" test="The walk does not recurse anymore"
           expect="The walk does not recurse"/>
  <pattern match="(?i)\bthe (?:former|old|previous|legacy|original) (\S+)" replace="the $1"
           where="comment" test="The old scanner reads a marker byte"
           expect="The scanner reads a marker byte"/>
  <!--
    These two name a change verb without naming who it happened to, so the
    subject decides the reading. A subject that opens the sentence's own
    assertion reports the tree, and that is a tombstone. A subject a
    subordinator opens, or one a noun hangs the clause off, reports a value the
    running code has already handled, and the rule stands down on it.
  -->
  <pattern match="(?i)\s*\b(?:was|were|has been|have been|had been|is now|are now) (?:renamed|removed|added|deleted|moved|replaced|introduced|dropped|split|merged|reverted|refactored|extracted|migrated|deprecated|rewritten|rewrote|bumped|reworked|consolidated|inlined|hoisted)\b[^.]*" replace=""
           where="comment" subject="preceding" test="The gate is now hoisted above the walk"
           expect="The gate"/>
  <pattern match="(?i)\s*\b(?:we|this|it|that) (?:renamed|removed|deleted|replaced|introduced|reverted|refactored|migrated|deprecated|rewrote|reworked|consolidated)\b[^.]*" replace=""
           where="comment" subject="matched" test="The list is derived we removed the flag"
           expect="The list is derived"/>
  <pattern match="(?i)\s*\bthis (?:replaces|supersedes)\b[^.]*" replace=""
           where="comment" test="The parse is the reader this replaces the scanner"
           expect="The parse is the reader"/>
  <pattern match="(?i)\s*\b(?:stopped (?:being|working|doing)|started (?:being|failing))\b[^.]*" replace=""
           where="comment" test="The cap holds stopped being read at start"
           expect="The cap holds"/>
  <pattern match="(?i)\s*\bthis (?:pr|pull request|change|diff|commit|patch|cl)\b[^.]*" replace=""
           where="comment" test="The walk is bounded this change keeps it so"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\bworth (?:noting|your attention|knowing here)\b[,]?" replace=""
           where="comment" test="Worth noting, the walk is bounded"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\b(?:as|when) requested\b" replace=""
           where="comment" test="The cap is off as requested"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\b(?:was never requested|nobody asked)\b[^.]*" replace=""
           where="comment" test="The cap is off nobody asked for it"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\bdo not (?:reintroduce|add this back|bring (?:it|this) back)\b[^.]*" replace=""
           where="comment" test="The cap is off do not reintroduce it"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\bper the (?:review|reviewer|feedback|comment)\b" replace=""
           where="comment" test="The cap is off per the review"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\b(?:flagging|to be clear|just to note|for the reviewer)\b[,]?" replace=""
           where="comment" test="To be clear, the walk is bounded"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\bthat is not (?:tidying|cleanup|cosmetic|churn|a rename|style|gratuitous)\b[^.]*" replace=""
           where="comment" test="The walk is bounded that is not cleanup"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\bthis is not (?:just )?(?:tidying|cleanup|cosmetic|churn|a rename|refactoring for)\b[^.]*" replace=""
           where="comment" test="The walk is bounded this is not cleanup"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\b(?:would have been|would otherwise have)\b[^.]*" replace=""
           where="comment" test="The walk is bounded it would have been slower"
           expect="The walk is bounded it"/>
  <pattern match="(?i)\s*\bnot (?:tidying|scope creep|gold.?plating)\b[^.]*" replace=""
           where="comment" test="The walk is bounded not scope creep"
           expect="The walk is bounded"/>
  <pattern match="(?i)\s*\bthe (?:owner|operator|user|reviewer|maintainer) (?:said|says|ruled|asked|wants|requested)\b[^.]*" replace=""
           where="comment" test="The cap is off the owner ruled it so"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\bper (?:the )?(?:owner|operator|user|maintainer)\b" replace=""
           where="comment" test="The cap is off per the owner"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\bby (?:owner|operator) (?:ruling|request|decree)\b" replace=""
           where="comment" test="The cap is off by owner ruling"
           expect="The cap is off"/>
  <pattern match="(?i)\s*\bnegative control\b[^.]*" replace=""
           where="comment" test="The gate holds negative control proved it"
           expect="The gate holds"/>
  <pattern match="(?i)\s*\b(?:i|we) (?:ran|tried|tested|measured|verified this by|checked this by)\b[^.]*" replace=""
           where="comment" test="The gate holds we ran it twice"
           expect="The gate holds"/>
  <pattern match="(?i)\s*\bverified by (?:breaking|deleting|removing|reverting)\b[^.]*" replace=""
           where="comment" test="The gate holds verified by deleting the rule"
           expect="The gate holds"/>
  <pattern match="(?i)\s*\brun before trusting\b[^.]*" replace=""
           where="comment" test="The gate holds run before trusting it"
           expect="The gate holds"/>

  <pattern match="\s+([,.;:!?])(\s|$)" replace="${1}${2}"
           test="A clause , and a stop ." expect="A clause, and a stop."/>

  <pattern match="  +" replace=" " test="Two  spaces" expect="Two spaces"/>

  <!--
    Prose that points at a position, or hedges about time. Nothing here asks a
    reader to decide: the phrase is cut and the sentence stands without it.

    A suggestion would need somebody to accept it, and the client this runs in
    has no way to accept one, so a rule that only suggests changes nothing.
  -->
  <pattern id="tombstones/position-reference"
           match="(?i)\s*\b(?:as mentioned|as noted|as described) (?:above|below)\b[,]?" replace=""
           where="comment" test="As mentioned above it races" expect="It races"/>
  <pattern id="tombstones/position-reference"
           match="(?i)\s*\bsee (?:above|below)\b[^.]*" replace=""
           where="comment" test="The lock is held see above for the reason"
           expect="The lock is held"/>
  <pattern id="tombstones/hedged-time"
           match="(?i)\s*\bfor now\b[,]?" replace=""
           where="comment" test="For now it retries once" expect="It retries once"/>
  <pattern id="tombstones/hedged-time"
           match="(?i)\s*\bcurrently\b[,]?" replace=""
           where="comment" test="It currently retries once" expect="It retries once"/>
  <pattern id="tombstones/hedged-time"
           match="(?i)\s*\bwill be\b[^.]*\b(?:later|soon|eventually|someday|in (?:a|the) future)\b[^.]*" replace=""
           where="comment" test="The retry count will be raised later"
           expect="The retry count"/>
  <pattern id="tombstones/unstated-value"
           match="(?i)\s*\bis (?:tbd|to be determined)\b" replace=" is not stated here"
           where="comment" test="The limit is TBD" expect="The limit is not stated here"/>
  <pattern id="tombstones/shrug"
           match="(?i)\s*\bfor some reason\b[,]?" replace=""
           where="comment" test="For some reason it races" expect="It races"/>
  <pattern id="tombstones/shrug"
           match="(?i)\s*\bdo not ask\b[^.]*" replace=""
           where="comment" test="The cap holds do not ask why"
           expect="The cap holds"/>
  <pattern id="tombstones/shrug"
           match="(?i)\s*\bobviously\b" replace=""
           where="comment" test="This is obviously wrong" expect="This is wrong"/>
  <pattern id="tombstones/unexplained-workaround"
           match="(?i)\ba hack around\b" replace="a workaround for"
           where="comment" test="A hack around the race" expect="A workaround for the race"/>
  <pattern id="tombstones/unexplained-workaround"
           match="(?i)\ba magic number\b" replace="a constant"
           where="comment" test="A magic number from the spec" expect="A constant from the spec"/>

  <!--
    A <flag> names a phrase without rewriting it, for the cases where no single
    replacement is right and inventing one would put a wrong sentence into a
    comment the reader trusts. `say` names what to write instead.
  -->
  <flag phrase="fixme" test="FIXME the retry count"
        say="say what is wrong and what it should be"/>
  <flag phrase="somehow" test="It somehow retries twice"
        say="find the mechanism or say you could not: a shrug helps nobody"/>

  <!--
    A <test> out here belongs to no entry. It is a line of prose and what the
    repair as a whole writes for it, which is where prose reaching several
    entries, or reaching none, is stated.

    The tidy pass closed the gap in front of every period it found, and a
    period with a word against its right side opens a file name rather than
    closing a sentence. Comments shipped reading `from the.gitmodules parser`.
    The gap closes only when the period closes something, which is what the
    space after it says.
  -->
  <test in="It reads from the .gitmodules parser above."
        out="It reads from the .gitmodules parser above."/>
  <test in="The walk skips .git and reads .gitmodules instead."
        out="The walk skips .git and reads .gitmodules instead."/>
  <test in="It reads the file ." out="It reads the file."/>
  <test in="It reads the file , and stops." out="It reads the file, and stops."/>
  <!-- go-toolchain docs. A deleted sentence takes its own period with it. -->
  <test in="This gate is deliberately not reduced. It previously ran the full pipeline against a native darwin/arm64 carve-out. The pipeline wedged."
        out="This gate is deliberately not reduced. The pipeline wedged."/>
  <test in="It waits... and then it reads." out="It waits... and then it reads."/>
  <!-- go-toolchain docs. A consequence names no time, and the sentence needs its predicate. -->
  <test in="So a nameless self-discovering download will be ambiguous here."
        out="So a nameless self-discovering download will be ambiguous here."/>

  <!--
    A doc comment opens on the identifier it documents, and that identifier is
    often unexported. Capitalising it names a symbol the package does not have,
    so the capital is restored only where a deletion removed the opening word.
  -->
  <!--
    A change verb read against the sentence it sits in. The first group states
    the change as the sentence's own assertion, so the tree it names is gone
    and the words come out. The second group hangs the same verb off a
    subordinator or off the noun in front of it, where it reports what the
    running code has done with a value, and the words stay.
  -->
  <test in="The retry loop was removed from the walk"
        out="The retry loop"/>
  <test in="The walk is bounded it removed the retry"
        out="The walk is bounded"/>
  <test in="It returns true when the element was added"
        out="It returns true when the element was added"/>
  <test in="The case passes because nothing was added"
        out="The case passes because nothing was added"/>
  <test in="It names the ones it rewrote on stdout"
        out="It names the ones it rewrote on stdout"/>
  <test in="The failure the whole rule was rewritten to avoid"
        out="The failure the whole rule was rewritten to avoid"/>

  <test in="arityReach is basically how far back it looks"
        out="arityReach is how far back it looks"/>
  <test in="english is actually the parsed table"
        out="english is the parsed table"/>
  <test in="Obviously it fails" out="It fails"/>

  <!-- A year in a copyright line goes stale. The holder stays. -->
  <test in="Copyright 2026 The Go Authors." out="Copyright The Go Authors."/>

</english>
