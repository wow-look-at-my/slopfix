<?xml version="1.0" encoding="UTF-8"?>
<!--
  commands.xml spells a command the way the shim accepts.

  The shim refuses `gh run`, `gh workflow` and `gh pr checks` at run time, so
  each of those spellings is a guaranteed failure that costs a whole tool call.

  `from` is the words a call opens with. `$id` matches a run id, so an expansion
  is left alone. A `--flag` in `from` is consumed wherever it sits among the
  remaining words. `to` is the words the call opens with instead, and `$id`
  there is the id `from` matched.

  positionals="none" refuses the rewrite when a word that is not a flag or a
  flag's value survives, because such a word names a subject the target
  spelling has nowhere to put.

  A form outside this table is left alone rather than guessed at: the shim
  already refuses it with the full mapping, and a wrong guess replaces a precise
  message with a command that asks a different question.
-->
<commands>
  <rewrite from="gh run view $id --log-failed" to="gh wait-ci log $id --failed"
           test="gh run view 42 --log-failed" expect="gh wait-ci log 42 --failed"/>
  <rewrite from="gh run view $id --log" to="gh wait-ci log $id"
           test="gh run view 42 --log" expect="gh wait-ci log 42"/>
  <rewrite from="gh run view $id" to="gh wait-ci view $id"
           test="gh run view 42" expect="gh wait-ci view 42"/>
  <rewrite from="gh run watch $id" to="gh wait-ci $id"
           test="gh run watch 42" expect="gh wait-ci 42"/>
  <rewrite from="gh run rerun $id" to="gh wait-ci rerun $id"
           test="gh run rerun 42" expect="gh wait-ci rerun 42"/>
  <rewrite from="gh run list" to="gh wait-ci runs" positionals="none"
           test="gh run list --limit 5" expect="gh wait-ci runs --limit 5"/>
  <rewrite from="gh pr checks" to="gh wait-ci checks" positionals="none"
           test="gh pr checks --watch" expect="gh wait-ci checks --watch"/>
</commands>
