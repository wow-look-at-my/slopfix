/build/

# ts-translate writes each grammar's parse table from the parser.c its own
# submodule carries. The output is derived, so the repository keeps the input
# and generates the rest at build time.
grammars/*/parser.gen.go
grammars/*/tables.zst
grammars/parser.gen.go
grammars/tables.zst

# precompiled/internal/gen writes a constant regexp for each pattern a table
# holds, so the compiler can precompile it.
precompiled/regexps.gen.go
