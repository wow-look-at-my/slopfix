<?xml version="1.1" encoding="UTF-8"?>
<!--
  Entries that are only wrong on one surface, which is what where= is for.

  An em dash joining two clauses is a chat habit. In a comment the prose rules
  already catch it as a comma splice, and rewriting it here would fight them.
-->
<rules for="english">

  <rewrite id="and" from="— and" to="," where="message">
    <test in="Yes — and there is precedent"/>
  </rewrite>
  <rewrite id="but" from="— but" to=", but" where="message">
    <test in="It works — but only once"/>
  </rewrite>
  <rewrite id="so" from="— so" to=", so" where="message">
    <test in="It failed — so I retried"/>
  </rewrite>
  <rewrite id="which" from="— which" to=", which" where="message">
    <test in="It races — which is the bug"/>
  </rewrite>
  <rewrite id="that-being-said" from="that being said" to="but" where="message">
    <test in="That being said it races"/>
  </rewrite>
  <drop id="it-is-important-to-note" word="it is important to note that" where="message">
    <test in="It is important to note that it races"/>
  </drop>

</rules>
