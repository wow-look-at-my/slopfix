<?xml version="1.1" encoding="UTF-8"?>
<!--
  Phrases where the number is idiom rather than a count. Nothing here counts
  anything, so the repair keeps the sentence and says the idiom another way.

  These lead the folder because they hold the longest phrases. A later entry
  matching "one" alone would otherwise take the word out of the middle of one
  of them and leave a phrase that means nothing.
-->
<rules xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="rules.xsd" for="numbers">

  <rewrite id="first-in-first-out" from="first-in-first-out" to="FIFO">
    <test in="A first-in-first-out queue" out="A FIFO queue"/>
  </rewrite>
  <rewrite id="first-in-first-out-2" from="first in, first out" to="FIFO">
    <test in="It is first in, first out" out="It is FIFO"/>
  </rewrite>
  <rewrite id="last-in-first-out" from="last-in-first-out" to="LIFO">
    <test in="A last-in-first-out stack" out="A LIFO stack"/>
  </rewrite>
  <rewrite id="last-in-first-out-2" from="last in, first out" to="LIFO">
    <test in="It is last in, first out" out="It is LIFO"/>
  </rewrite>
  <rewrite id="one-another" from="one another" to="each other">
    <test in="They wait for one another" out="They wait for each other"/>
  </rewrite>
  <rewrite id="another-one" from="another one" to="another">
    <test in="It cannot block another one" out="It cannot block another"/>
  </rewrite>
  <rewrite id="no-one" from="no one" to="nobody">
    <test in="No one reads it" out="Nobody reads it"/>
  </rewrite>
  <rewrite id="all-at-once" from="all at once" to="together">
    <test in="It releases all at once" out="It releases together"/>
  </rewrite>
  <rewrite id="at-once" from="at once" to="at the same time">
    <test in="Both run at once" out="Both run at the same time"/>
  </rewrite>

</rules>
