<?xml version="1.1" encoding="UTF-8"?>
<!--
  An ordinal names a position, and a position moves when somebody inserts an
  item above it. These say the relation instead, which survives the insert.

  The enumeration openers go before the position entries: "First, it locks"
  opens a list, where "the first writer" names a thing.
-->
<rules xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="rules.xsd" for="numbers">

  <pattern id="i-bfirst-s" match="(?i)\bfirst,\s+" to="">
    <test in="First, it locks" out="It locks"/>
  </pattern>
  <pattern id="i-bsecond-s" match="(?i)\bsecond,\s+" to="then ">
    <test in="Second, it writes" out="Then it writes"/>
  </pattern>
  <pattern id="i-bthird-s" match="(?i)\bthird,\s+" to="then ">
    <test in="Third, it unlocks" out="Then it unlocks"/>
  </pattern>

  <pattern id="i-ba-second-b" match="(?i)\ba second\b" to="another">
    <test in="It grows a second segment" out="It grows another segment"/>
  </pattern>
  <pattern id="i-bthe-second-b" match="(?i)\bthe second\b" to="the next">
    <test in="The second call wins" out="The next call wins"/>
  </pattern>
  <pattern id="i-bthe-first-b" match="(?i)\bthe first\b" to="the earliest">
    <test in="The first writer wins" out="The earliest writer wins"/>
  </pattern>
  <pattern id="i-bfirst-b" match="(?i)\bfirst\b" to="earliest">
    <test in="It takes first" out="It takes earliest"/>
  </pattern>

</rules>
