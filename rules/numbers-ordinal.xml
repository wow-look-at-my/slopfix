<?xml version="1.0" encoding="UTF-8"?>
<!--
  An ordinal names a position, and a position moves when somebody inserts an
  item above it. These say the relation instead, which survives the insert.

  The enumeration openers go before the position entries: "First, it locks"
  opens a list, where "the first writer" names a thing.
-->
<rules for="numbers">

  <pattern match="(?i)\bfirst,\s+" to="" test="First, it locks" expect="It locks"/>
  <pattern match="(?i)\bsecond,\s+" to="then " test="Second, it writes" expect="Then it writes"/>
  <pattern match="(?i)\bthird,\s+" to="then " test="Third, it unlocks" expect="Then it unlocks"/>

  <pattern match="(?i)\ba second\b" to="another" test="It grows a second segment" expect="It grows another segment"/>
  <pattern match="(?i)\bthe second\b" to="the next" test="The second call wins" expect="The next call wins"/>
  <pattern match="(?i)\bthe first\b" to="the earliest" test="The first writer wins" expect="The earliest writer wins"/>
  <pattern match="(?i)\bfirst\b" to="earliest" test="It takes first" expect="It takes earliest"/>

</rules>
