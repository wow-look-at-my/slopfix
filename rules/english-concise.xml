<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phrases with a shorter spelling that means the same thing. The swap holds in
  every context the phrase appears in, which is what lets a repair apply it
  with nobody reviewing the result.
-->
<rules for="english">

  <rewrite id="in-order-to" from="in order to" to="to">
    <test in="Runs in order to bind"/>
  </rewrite>
  <rewrite id="due-to-the-fact-that" from="due to the fact that" to="because">
    <test in="Fails due to the fact that it races"/>
  </rewrite>
  <rewrite id="in-the-event-that" from="in the event that" to="if">
    <test in="Retries in the event that it fails"/>
  </rewrite>
  <rewrite id="for-the-purpose-of" from="for the purpose of" to="for">
    <test in="Kept for the purpose of the gate"/>
  </rewrite>
  <rewrite id="a-large-number-of" from="a large number of" to="many">
    <test in="Holds a large number of entries"/>
  </rewrite>
  <rewrite id="at-this-point-in-time" from="at this point in time" to="now">
    <test in="Correct at this point in time"/>
  </rewrite>
  <rewrite id="is-able-to" from="is able to" to="can">
    <test in="It is able to retry"/>
  </rewrite>
  <rewrite id="has-the-ability-to" from="has the ability to" to="can">
    <test in="It has the ability to retry"/>
  </rewrite>
  <rewrite id="make-use-of" from="make use of" to="use">
    <test in="It will make use of the cache"/>
  </rewrite>
  <rewrite id="take-into-account" from="take into account" to="consider">
    <test in="It must take into account the offset"/>
  </rewrite>
  <rewrite id="the-reason-is-because" from="the reason is because" to="because">
    <test in="The reason is because it races"/>
  </rewrite>
  <rewrite id="in-spite-of-the-fact" from="in spite of the fact that" to="although">
    <test in="Kept in spite of the fact that it races"/>
  </rewrite>
  <rewrite id="a-sufficient-number-of" from="a sufficient number of" to="enough">
    <test in="Holds a sufficient number of entries"/>
  </rewrite>
  <rewrite id="prior-to" from="prior to" to="before">
    <test in="Runs prior to the gate"/>
  </rewrite>
  <rewrite id="subsequent-to" from="subsequent to" to="after">
    <test in="Runs subsequent to the gate"/>
  </rewrite>
  <rewrite id="in-the-near-future" from="in the near future" to="soon">
    <test in="Lands in the near future"/>
  </rewrite>
  <rewrite id="on-a-regular-basis" from="on a regular basis" to="regularly">
    <test in="Runs on a regular basis"/>
  </rewrite>
  <rewrite id="whether-or-not" from="whether or not" to="whether">
    <test in="Asks whether or not it fits"/>
  </rewrite>

</rules>
