<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the numbers table writes for a line of comment prose, as a whole. An
  entry's own test drives that entry alone. A case here drives every entry at
  once, which is where a phrase reaching two of them, or reaching none, is
  stated.

  A case whose expect repeats its test names prose the table declines. Those
  hold the matching inside a word boundary, and dropping one lets a rewrite
  loose inside a name.
-->
<rules for="numbers">

  <case test="sync.Once guards it" expect="sync.Once guards it"/>
  <case test="net/http serves it" expect="net/http serves it"/>
  <case test="it calls Do.Once here" expect="it calls Do.Once here"/>
  <case test="the once flag" expect="the a single time flag"/>
  <case test="The oneShot flag and someone else" expect="The oneShot flag and someone else"/>

  <case test="Tests for .github/scripts/register.sh, the step it runs"
        expect="Tests for .github/scripts/register.sh, the step it runs"/>
  <case test="The suite lives in .dats files" expect="The suite lives in .dats files"/>
  <case test="Ignored by .gitignore already" expect="Ignored by .gitignore already"/>

  <case test="exactly one of s or other." expect="a single side of s or other."/>
  <case test="Two goroutines contend" expect="Goroutines contend"/>

  <case test="It reserves one slot ." expect="It reserves a single slot."/>
  <case test="It locks , then writes ." expect="It locks, then writes."/>

  <case test="It reserves a slot and publishes it" expect="It reserves a slot and publishes it"/>

</rules>
