<?xml version="1.1" encoding="UTF-8"?>
<!--
  Words that survive their own deletion. A <drop> whose word changes meaning in
  some context does not belong here at all: a wrong deletion is worse than a
  comment left long, because nobody reviews what a repair applied.
-->
<rules for="english">

  <drop id="actually" word="actually">
    <test in="It actually fails"/>
  </drop>
  <drop id="basically" word="basically">
    <test in="It basically fails"/>
  </drop>
  <drop id="essentially" word="essentially">
    <test in="It essentially fails"/>
  </drop>
  <drop id="fundamentally" word="fundamentally">
    <test in="It fundamentally fails"/>
  </drop>
  <drop id="simply" word="simply">
    <test in="It simply fails"/>
  </drop>
  <drop id="obviously" word="obviously">
    <test in="It obviously fails"/>
  </drop>
  <drop id="clearly" word="clearly">
    <test in="It clearly fails"/>
  </drop>
  <drop id="of-course" word="of course">
    <test in="It of course fails"/>
  </drop>
  <drop id="in-fact" word="in fact">
    <test in="It in fact fails"/>
  </drop>
  <drop id="indeed" word="indeed">
    <test in="It indeed fails"/>
  </drop>
  <drop id="really" word="really">
    <test in="It really fails"/>
  </drop>
  <drop id="very" word="very">
    <test in="A very long name"/>
  </drop>
  <drop id="quite" word="quite">
    <test in="A quite long name"/>
  </drop>
  <drop id="somewhat" word="somewhat">
    <test in="A somewhat long name"/>
  </drop>
  <drop id="fairly" word="fairly">
    <test in="A fairly long name"/>
  </drop>
  <drop id="just" word="just">
    <test in="It just fails"/>
  </drop>
  <drop id="note-that" word="note that">
    <test in="Note that it fails"/>
  </drop>
  <drop id="it-is-worth-noting-that" word="it is worth noting that">
    <test in="It is worth noting that it fails"/>
  </drop>
  <drop id="please-note-that" word="please note that">
    <test in="Please note that it fails"/>
  </drop>
  <drop id="needless-to-say" word="needless to say">
    <test in="Needless to say it fails"/>
  </drop>
  <drop id="at-the-end-of-the" word="at the end of the day">
    <test in="At the end of the day it fails"/>
  </drop>
  <drop id="for-the-purposes-of" word="for the purposes of">
    <test in="For the purposes of the check"/>
  </drop>
  <drop id="with-respect-to" word="with respect to">
    <test in="With respect to the check"/>
  </drop>

</rules>
