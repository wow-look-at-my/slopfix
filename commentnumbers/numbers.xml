<?xml version="1.0" encoding="UTF-8"?>
<!--
  The English the number repair applies before it cuts anything.

  This is the same shape as commentlength/english.xml and autoallow/rules.xml,
  and for the same reason: a rule a reader can edit without reading Go is a rule
  that gets edited.

  A <rewrite> swaps a whole phrase, lowercased, between word boundaries. A
  <pattern> carries a shape a phrase swap cannot express, and runs after every
  rewrite, so it sees the text the swaps settled. Order inside each kind is the
  order here.

  Every entry carries `test` and `expect`: the phrase as a comment writes it, and
  the phrase the repair must produce. numbers_test.go drives each one, so an
  entry that has stopped firing says so rather than sitting here looking
  enforced.

  An entry belongs here only when the swap keeps the meaning in EVERY context the
  phrase appears in. A number the table cannot rewrite is not guessed at: the
  repair cuts the sentence carrying it, and reports what it cut.
-->
<numbers>

  <!-- Phrases where the number is idiom rather than a count. -->
  <rewrite from="first-in-first-out" to="FIFO" test="A first-in-first-out queue" expect="A FIFO queue"/>
  <rewrite from="first in, first out" to="FIFO" test="It is first in, first out" expect="It is FIFO"/>
  <rewrite from="last-in-first-out" to="LIFO" test="A last-in-first-out stack" expect="A LIFO stack"/>
  <rewrite from="last in, first out" to="LIFO" test="It is last in, first out" expect="It is LIFO"/>
  <rewrite from="one another" to="each other" test="They wait for one another" expect="They wait for each other"/>
  <rewrite from="another one" to="another" test="It cannot block another one" expect="It cannot block another"/>
  <rewrite from="no one" to="nobody" test="No one reads it" expect="Nobody reads it"/>
  <rewrite from="all at once" to="together" test="It releases all at once" expect="It releases together"/>
  <rewrite from="at once" to="at the same time" test="Both run at once" expect="Both run at the same time"/>

  <!-- A repeat count, said without a number. -->
  <rewrite from="exactly once" to="exactly a single time" test="It runs exactly once" expect="It runs exactly a single time"/>
  <rewrite from="only once" to="a single time" test="It runs only once" expect="It runs a single time"/>
  <rewrite from="once" to="a single time" test="It hashes once" expect="It hashes a single time"/>
  <rewrite from="twice" to="again" test="It hashes the key twice" expect="It hashes the key again"/>

  <!-- The Go idiom. An unset value is what the reader is being told about. -->
  <rewrite from="the zero value" to="an unset value" test="The zero value is ready" expect="An unset value is ready"/>
  <rewrite from="zero value" to="unset value" test="Its zero value is ready" expect="Its unset value is ready"/>
  <rewrite from="zero" to="empty" test="It returns zero and false" expect="It returns empty and false"/>

  <!-- An ordinal opening an enumeration. The order is the sentence order. -->
  <pattern match="(?i)\bfirst,\s+" to="" test="First, it locks" expect="It locks"/>
  <pattern match="(?i)\bsecond,\s+" to="then " test="Second, it writes" expect="Then it writes"/>
  <pattern match="(?i)\bthird,\s+" to="then " test="Third, it unlocks" expect="Then it unlocks"/>

  <!-- An ordinal naming a position, said as a relation instead. -->
  <pattern match="(?i)\ba second\b" to="another" test="It grows a second segment" expect="It grows another segment"/>
  <pattern match="(?i)\bthe second\b" to="the next" test="The second call wins" expect="The next call wins"/>
  <pattern match="(?i)\bthe first\b" to="the earliest" test="The first writer wins" expect="The earliest writer wins"/>
  <pattern match="(?i)\bfirst\b" to="earliest" test="It takes first" expect="It takes earliest"/>

  <!-- One as a determiner: an article says the same thing and stays true. The
       group carries the noun's opening letter, because RE2 has no lookahead. -->
  <pattern match="(?i)\bone\s+([aeiou])" to="an ${1}" test="It costs one atomic add" expect="It costs an atomic add"/>
  <pattern match="(?i)\bone\s+([a-z])" to="a ${1}" test="It reserves one slot" expect="It reserves a slot"/>

  <!-- A plural tally: the noun carries the meaning and the number goes. -->
  <pattern match="(?i)\b(?:two|three|four|five|six|seven|eight|nine|ten|dozen)\s+([a-z])" to="${1}" test="Two goroutines contend" expect="Goroutines contend"/>

</numbers>
